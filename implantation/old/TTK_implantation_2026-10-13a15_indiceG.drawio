&gt;E4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Thermocouple tête 1&lt;/td&gt;&lt;td&gt;M16 – À COMMANDER&lt;/td&gt;&lt;td&gt;Ø16.5&lt;/td&gt;&lt;td&gt;200&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;td&gt;À COMMANDER&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Thermocouple tête 2&lt;/td&gt;&lt;td&gt;M16 – À COMMANDER&lt;/td&gt;&lt;td&gt;Ø16.5&lt;/td&gt;&lt;td&gt;235&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;td&gt;À COMMANDER&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Arrivée 3P+N+PE&lt;/td&gt;&lt;td&gt;Nylon M25 (13–18 mm)&lt;/td&gt;&lt;td&gt;Ø25.5&lt;/td&gt;&lt;td&gt;560&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;td&gt;en stock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Moteur M1 2XSLCY-K 4G2,5&lt;/td&gt;&lt;td&gt;CEM blueglobe TRI M25&lt;/td&gt;&lt;td&gt;Ø25.5&lt;/td&gt;&lt;td&gt;610&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;td&gt;en stock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Moteur M2 2XSLCY-K 4G2,5&lt;/td&gt;&lt;td&gt;CEM blueglobe TRI M25&lt;/td&gt;&lt;td&gt;Ø25.5&lt;/td&gt;&lt;td&gt;660&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;td&gt;en stock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Pas-à-pas axe 1 LIYCY-JZ 5G1,5&lt;/td&gt;&lt;td&gt;CEM blueglobe TRI M20&lt;/td&gt;&lt;td&gt;Ø20.5&lt;/td&gt;&lt;td&gt;706&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;td&gt;en stock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Pas-à-pas axe 2 LIYCY-JZ 5G1,5&lt;/td&gt;&lt;td&gt;CEM blueglobe TRI M20&lt;/td&gt;&lt;td&gt;Ø20.5&lt;/td&gt;&lt;td&gt;748&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;td&gt;en stock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E11&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Frein BE5 M1 câble 2×1,5&lt;/td&gt;&lt;td&gt;Nylon M20 (8–12 mm)&lt;/td&gt;&lt;td&gt;Ø20.5&lt;/td&gt;&lt;td&gt;610&lt;/td&gt;&lt;td&gt;milieu&lt;/td&gt;&lt;td&gt;en stock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Frein BE5 M2 câble 2×1,5&lt;/td&gt;&lt;td&gt;Nylon M20 (8–12 mm)&lt;/td&gt;&lt;td&gt;Ø20.5&lt;/td&gt;&lt;td&gt;652&lt;/td&gt;&lt;td&gt;milieu&lt;/td&gt;&lt;td&gt;en stock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E13&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Sonde TF M1 LIYCY 2×0,75&lt;/td&gt;&lt;td&gt;CEM blueglobe TRI M16&lt;/td&gt;&lt;td&gt;Ø16.5&lt;/td&gt;&lt;td&gt;694&lt;/td&gt;&lt;td&gt;milieu&lt;/td&gt;&lt;td&gt;en stock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E14&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Sonde TF M2 LIYCY 2×0,75&lt;/td&gt;&lt;td&gt;CEM blueglobe TRI M16&lt;/td&gt;&lt;td&gt;Ø16.5&lt;/td&gt;&lt;td&gt;731&lt;/td&gt;&lt;td&gt;milieu&lt;/td&gt;&lt;td&gt;en stock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E15&lt;/b&gt;&lt;/td&gt;&lt;td&gt;RJ45 KTP700 Cat6 20 m surmoulé&lt;/td&gt;&lt;td&gt;Entrée fendue pour connecteur surmoulé, ou RJ45 à sertir sur site + M16&lt;/td&gt;&lt;td&gt;selon solution&lt;/td&gt;&lt;td&gt;295&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;td&gt;À DÉFINIR&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="120.0" y="590.0" width="900.0" height="420.0" as="geometry"/></mxCell><mxCell id="c270" value="&lt;b&gt;Règles appliquées&lt;/b&gt;&lt;br&gt;– Commande à gauche, sous X1–X4 ; puissance à droite, sous X5, X6, PE et la goulotte GV-D.&lt;br&gt;– Gros câbles et câbles CEM sur la bande arrière, au plus près de la plaque.&lt;br&gt;– Bande avant laissée en réserve (≈ 950 mm de bande libre).&lt;br&gt;– Entraxes mini : M25 50 mm, M20 42 mm, M16 35 mm ; 50 mm mini des bouts de bande.&lt;br&gt;– Perçage au foret étagé ou à l'emporte-pièce ; ébavurer. Contre-écrou côté intérieur.&lt;br&gt;– Presse-étoupes CEM : tresse de blindage rabattue dans le cône, contact métal sur tôle nue (gratter la peinture sous l'écrou ou rondelle de contact).&lt;br&gt;&lt;br&gt;&lt;b&gt;À vérifier&lt;/b&gt;&lt;br&gt;– Hypothèse : plaque sol centrée sous la plaque de montage (X sol = X plaque − 75). À contrôler sur l'armoire avant perçage.&lt;br&gt;– Diamètres extérieurs réels des câbles vs plages de serrage (blueglobe TRI non vérifiées).&lt;br&gt;– Câble des freins 2×1,5 : vérifier que son Ø est ≥ 8 mm (plage du M20 nylon).&lt;br&gt;– Stock non affecté : 1 nylon M25, 1 nylon M20." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;spacing=8;" vertex="1" parent="1"><mxGeometry x="1110.0" y="180.0" width="380.0" height="520.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="Câblage par fonction"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lay_fond" value="0 – Fond de plan (verrouillé)" style="locked=1;" parent="0"/><mxCell id="lay_AC" value="1 – Puissance AC 400/230 V" parent="0"/><mxCell id="lay_PE" value="2 – Terre PE et masses" parent="0"/><mxCell id="lay_DC" value="3 – Distribution 24 V" parent="0"/><mxCell id="lay_SEC" value="4 – Sécurité (AU, capot, STO, bobines)" parent="0"/><mxCell id="lay_SIG" value="5 – Signaux automate" parent="0"/><mxCell id="lay_V48" value="6 – 48 V et moteurs pas-à-pas" parent="0"/><mxCell id="lay_PN" value="7 – PROFINET" parent="0"/><mxCell id="lay_TER" value="8 – Câbles terrain dans l'armoire" parent="0"/><mxCell id="c271" value="" style="html=1;fillColor=#FAFAFA;strokeColor=#999999;strokeWidth=2;" vertex="1" parent="lay_fond"><mxGeometry x="120.0" y="140.0" width="1100.0" height="1670.0" as="geometry"/></mxCell><mxCell id="c272" value="GV-G (commande)" style="html=1;fillColor=#EEEEEE;strokeColor=#BBBBBB;fontSize=10;fontColor=#999999;horizontal=0;" vertex="1" parent="lay_fond"><mxGeometry x="150.0" y="170.0" width="60.0" height="1610.0" as="geomet