" as="geometry"/></mxCell><mxCell id="c462" value="trou 1&lt;br&gt;&lt;b&gt;arrivée QF1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#333333;strokeWidth=1;fontSize=10;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="830.0" y="360.0" width="110.0" height="50.0" as="geometry"/></mxCell><mxCell id="c463" value="trou 2&lt;br&gt;&lt;b&gt;QF4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;strokeWidth=1;fontSize=10;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="944.0" y="360.0" width="110.0" height="50.0" as="geometry"/></mxCell><mxCell id="c464" value="trou 3&lt;br&gt;&lt;b&gt;QF5&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;strokeWidth=1;fontSize=10;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1058.0" y="360.0" width="110.0" height="50.0" as="geometry"/></mxCell><mxCell id="c465" value="trou 4&lt;br&gt;&lt;b&gt;QF6&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;strokeWidth=1;fontSize=10;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1172.0" y="360.0" width="110.0" height="50.0" as="geometry"/></mxCell><mxCell id="c466" value="trou 5&lt;br&gt;&lt;b&gt;QF7&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;strokeWidth=1;fontSize=10;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1286.0" y="360.0" width="110.0" height="50.0" as="geometry"/></mxCell><mxCell id="c467" value="&lt;b&gt;Réserve par pôle&lt;/b&gt; : L1 = 2 ; L2 = 4 ; L3 = 1 ; N = 1&lt;br&gt;Si la borne de QF1 n'accepte pas 2 fils : RÉP2 alimenté depuis un petit trou de RÉP1 → 1 trou de moins par pôle (L3 et N à 0 de réserve).&lt;br&gt;H2 : phase L3 sur RÉP2, neutre sur RÉP1. QF8 et QF9 : phase sur RÉP2, neutre sur RÉP1. Repérer les fils aux deux bouts." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60.0" y="450.0" width="1400.0" height="120.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>