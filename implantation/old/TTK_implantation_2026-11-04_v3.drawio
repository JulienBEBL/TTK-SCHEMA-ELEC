wrap;fontSize=8;align=center;verticalAlign=top;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="890.0" y="203.8" width="40.0" height="14.0" as="geometry"/></mxCell><mxCell id="c406" value="" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF0000;strokeWidth=2;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="749.8" y="279.8" width="20.5" height="20.5" as="geometry"/></mxCell><mxCell id="c407" value="&lt;b&gt;E11&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=8;align=center;verticalAlign=top;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="740.0" y="301.2" width="40.0" height="14.0" as="geometry"/></mxCell><mxCell id="c408" value="" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF0000;strokeWidth=2;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="791.8" y="279.8" width="20.5" height="20.5" as="geometry"/></mxCell><mxCell id="c409" value="&lt;b&gt;E12&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=8;align=center;verticalAlign=top;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="782.0" y="301.2" width="40.0" height="14.0" as="geometry"/></mxCell><mxCell id="c410" value="" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="835.8" y="281.8" width="16.5" height="16.5" as="geometry"/></mxCell><mxCell id="c411" value="&lt;b&gt;E13&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=8;align=center;verticalAlign=top;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="824.0" y="299.2" width="40.0" height="14.0" as="geometry"/></mxCell><mxCell id="c412" value="" style="ellipse;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="870.8" y="281.8" width="16.5" height="16.5" as="geometry"/></mxCell><mxCell id="c413" value="&lt;b&gt;E14&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=8;align=center;verticalAlign=top;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="859.0" y="299.2" width="40.0" height="14.0" as="geometry"/></mxCell><mxCell id="c414" value="&lt;table border='1' cellpadding='3' style='border-collapse:collapse;font-size:10px'&gt;&lt;tr style='background:#DDDDDD'&gt;&lt;th&gt;Entrée&lt;/th&gt;&lt;th&gt;Câble&lt;/th&gt;&lt;th&gt;Presse-étoupe&lt;/th&gt;&lt;th&gt;Perçage&lt;/th&gt;&lt;th&gt;X sol&lt;/th&gt;&lt;th&gt;Bande&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;27G1 pupitre +P1&lt;/td&gt;&lt;td&gt;CEM M25&lt;/td&gt;&lt;td&gt;Ø25.5&lt;/td&gt;&lt;td&gt;180&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;19G1 machine +M (signaux, H1)&lt;/td&gt;&lt;td&gt;CEM M25&lt;/td&gt;&lt;td&gt;Ø25.5&lt;/td&gt;&lt;td&gt;300&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Câble M12 capteur B2&lt;/td&gt;&lt;td&gt;M16 (à acheter)&lt;/td&gt;&lt;td&gt;Ø16.5&lt;/td&gt;&lt;td&gt;345&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W8 thermocouple (compensation K)&lt;/td&gt;&lt;td&gt;M16 CEM ? (à acheter)&lt;/td&gt;&lt;td&gt;Ø16.5&lt;/td&gt;&lt;td&gt;440&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;RJ45 IHM P1&lt;/td&gt;&lt;td&gt;entrée fendue ou RJ45 à sertir (à définir)&lt;/td&gt;&lt;td&gt;Ø25.5&lt;/td&gt;&lt;td&gt;100&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W9 pas-à-pas M3&lt;/td&gt;&lt;td&gt;CEM M20&lt;/td&gt;&lt;td&gt;Ø20.5&lt;/td&gt;&lt;td&gt;570&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W10 pas-à-pas M4&lt;/td&gt;&lt;td&gt;CEM M20&lt;/td&gt;&lt;td&gt;Ø20.5&lt;/td&gt;&lt;td&gt;612&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W2 moteur M1 2XSLCY-K 4G2,5&lt;/td&gt;&lt;td&gt;CEM M25&lt;/td&gt;&lt;td&gt;Ø25.5&lt;/td&gt;&lt;td&gt;680&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W5 moteur M2&lt;/td&gt;&lt;td&gt;CEM M25&lt;/td&gt;&lt;td&gt;Ø25.5&lt;/td&gt;&lt;td&gt;730&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W1 réseau 5G4&lt;/td&gt;&lt;td&gt;nylon M25&lt;/td&gt;&lt;td&gt;Ø25.5&lt;/td&gt;&lt;td&gt;830&lt;/td&gt;&lt;td&gt;arrière&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E11&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W3 frein M1 LIYCY-JZ 5G1,5 blindé&lt;/td&gt;&lt;td&gt;CEM M20 (à acheter)&lt;/td&gt;&lt;td&gt;Ø20.5&lt;/td&gt;&lt;td&gt;680&lt;/td&gt;&lt;td&gt;milieu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W6 frein M2&lt;/td&gt;&lt;td&gt;CEM M20 (à acheter)&lt;/td&gt;&lt;td&gt;Ø20.5&lt;/td&gt;&lt;td&gt;722&lt;/td&gt;&lt;td&gt;milieu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E13&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W4 sonde TF M1 2x0,75 blindé&lt;/td&gt;&lt;td&gt;CEM M16&lt;/td&gt;&lt;td&gt;Ø16.5&lt;/td&gt;&lt;td&gt;764&lt;/td&gt;&lt;td&gt;milieu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;E14&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W7 sonde TF M2&lt;/td&gt;&lt;td&gt;CEM M16&lt;/td&gt;&lt;td&gt;Ø16.5&lt;/td&gt;&lt;td&gt;799&lt;/td&gt;&lt;td&gt;milieu&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;CEM en stock : 4 M25, 2 M20, 2 M16. Besoin : 4 M25, 4 M20, 2-3 M16 → manque 2 CEM M20 (+1 M16 si W8 blindé). Revue C2." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80.0" y="470.0" width="1100.0" height="600.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 Répartiteurs"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c415" value="&lt;b&gt;Répartiteurs AEE300427 – affectation des petits départs (1,5 à 6 mm²)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60.0" y="60.0" width="1600.0" height="30.0" as="geometry"/></mxCell><mxCell id="c416" value="Fil 4 mm² partout. Entrées 10-35 mm² et gros départs 6-16 mm² NON utilisés (4 mm² hors plage de serrage). Chaque répartiteur est alimenté par QF1 : 2 fils de 4 mm² par borne de sortie de QF1 (à vérifier sur la notice Hager)." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60.0" y="90.0" width="1600.0" height="20.0" as="geometry"/></mxCell><mxCell id="c417" value="&lt;b&gt;RÉP1&lt;/b&gt; – R2 – 400 V moteurs, freins + neutres H2 / QF8 / QF9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#333333;strokeWidth=1;fontSize=11;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60.0" y="140.0" width="640.0" height="30.0" as="geometry"/></mxCell><mxCell id="c418" value="&lt;b&gt;L1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#000000;strokeWidth=1;fontSize=12;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60.0" y="180.0" width="60.0" height="50.0" as="geometry"/></mxCell><mxCell id="c419" value="trou 1&lt;br&gt;&lt;b&gt;arrivée QF1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#333333;strokeWidth=1;fo