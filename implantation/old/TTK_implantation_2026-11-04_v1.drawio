0000;" vertex="1" parent="1"><mxGeometry x="430.0" y="795.0" width="100.0" height="40.0" as="geometry"/></mxCell><mxCell id="c376" value="&lt;b&gt;S4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;strokeWidth=1;fontSize=9;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="360.0" y="890.0" width="40.0" height="40.0" as="geometry"/></mxCell><mxCell id="c377" value="Réarmement&lt;br&gt;&lt;i&gt;XB4BA21 noir&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=7;align=center;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="310.0" y="935.0" width="140.0" height="30.0" as="geometry"/></mxCell><mxCell id="c378" value="&lt;b&gt;S1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF0000;strokeColor=#000000;strokeWidth=1;fontSize=10;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="350.0" y="1010.0" width="60.0" height="60.0" as="geometry"/></mxCell><mxCell id="c379" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=3;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="335.0" y="995.0" width="90.0" height="90.0" as="geometry"/></mxCell><mxCell id="c380" value="AU armoire XB5AS8442&lt;br&gt;+ ZBE102 + ZBE101 (2 NF + 1 NO)" style="text;html=1;whiteSpace=wrap;fontSize=7;align=center;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300.0" y="1090.0" width="160.0" height="40.0" as="geometry"/></mxCell><mxCell id="c381" value="" style="endArrow=none;html=1;strokeColor=#806000;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="1150.0" as="sourcePoint"/><mxPoint x="380.0" y="1860.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c382" value="Faisceau fil souple sous gaine spiralée,&lt;br&gt;boucle à la charnière, vers bornes&lt;br&gt;« Porte » de R5 :&lt;br&gt;S1 → X41.51–54, X60.41–42&lt;br&gt;S4, H2, H3, H4 : selon schéma v16" style="text;html=1;whiteSpace=wrap;fontSize=8;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="390.0" y="1420.0" width="280.0" height="140.0" as="geometry"/></mxCell><mxCell id="c383" value="&lt;b&gt;À valider / à relever&lt;/b&gt;&lt;br&gt;1. Dimensions de la porte et zones libres (renforts, serrure).&lt;br&gt;2. Hauteur des appareils : proposée autour de 1,2 à 1,5 m du sol.&lt;br&gt;3. Perçage Ø22,5 pour les têtes Ø22 (vérifier sur la notice Schneider).&lt;br&gt;4. Entraxe 100 mm proposé : à vérifier avec l'encombrement des blocs contacts derrière la porte.&lt;br&gt;5. H2 en 230 V sur la porte : tresse de masse porte → PE (revue C11)." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760.0" y="220.0" width="700.0" height="400.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 Passe-câbles"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c384" value="&lt;b&gt;Plaque passe-câbles (sol) – mise à jour v16 – vue de dessus, avant en bas&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80.0" y="70.0" width="1600.0" height="30.0" as="geometry"/></mxCell><mxCell id="c385" value="950 × 300, 3 bandes de 100. X sol = X plaque − 75 (hypothèse : plaque sol centrée, à contrôler)." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80.0" y="100.0" width="1600.0" height="20.0" as="geometry"/></mxCell><mxCell id="c386" value="" style="rounded=0;whiteSpace=wrap;html=1;fill