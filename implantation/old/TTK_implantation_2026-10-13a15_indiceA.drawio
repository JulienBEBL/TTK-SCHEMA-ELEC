"><mxPoint x="1220.0" y="1330.0" as="sourcePoint"/><mxPoint x="1248.0" y="1330.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c169" value="R5 : axe Y 1465 ; X 100 → 1000" style="text;html=1;fontSize=10;align=left;fontColor=#0050A0;" vertex="1" parent="1"><mxGeometry x="1400.0" y="1768.0" width="260.0" height="14.0" as="geometry"/></mxCell><mxCell id="c170" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#0050A0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="1605.0" as="sourcePoint"/><mxPoint x="1248.0" y="1605.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c171" value="90 (bord → fin GV-G)" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=4;startSize=4;html=1;fontSize=11;strokeColor=#0050A0;fontColor=#0050A0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="1840.0" as="sourcePoint"/><mxPoint x="210.0" y="1840.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c172" value="90" style="endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=4;startSize=4;html=1;fontSize=11;strokeColor=#0050A0;fontColor=#0050A0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130.0" y="1840.0" as="sourcePoint"/><mxPoint x="1220.0" y="1840.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c173" value="Ventilateur ENTRÉE&lt;br&gt;VF92AC bas gauche&lt;br&gt;(paroi latérale)" style="shape=mxgraph.electrical.rot_mech.blower;html=1;rounded=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=9;" vertex="1" parent="1"><mxGeometry x="5.0" y="1550.0" width="100.0" height="70.0" as="geometry"/></mxCell><mxCell id="c174" value="Ventilateur SORTIE&lt;br&gt;VF92AC haut droit&lt;br&gt;(paroi latérale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1225.0" y="180.0" width="100.0" height="70.0" as="geometry"/></mxCell><mxCell id="c175" value="▼ ENTRÉE DES CÂBLES PAR LE BAS : commande/terrain côté GAUCHE – puissance/moteurs côté DROIT ▼" style="text;html=1;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120.0" y="1870.0" width="1100.0" height="30.0" as="geometry"/></mxCell><mxCell id="c176" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;&lt;font color='#C00000'&gt;●&lt;/font&gt; perçage fixation goulotte (axe)&lt;br&gt;&lt;font color='#0050A0'&gt;●&lt;/font&gt; perçage fixation rail DIN (axe)&lt;br&gt;&lt;font color='#008000'&gt;●&lt;/font&gt; perçage appareil (variateur, entraxe 40×200 – à valider sur pièce)&lt;br&gt;Trait plein : dimensions vérifiées (fiche/notice)&lt;br&gt;Trait pointillé fin : dimensions supposées (à relever à réception)&lt;br&gt;Trait pointillé épais : zone réservée, dimensions inconnues&lt;br&gt;&lt;font color='#FF0000'&gt;Rouge pointillé&lt;/font&gt; : élément ABSENT du Tableau V1 (place réservée)&lt;br&gt;&lt;br&gt;&lt;b&gt;Fixation&lt;/b&gt; (le plus rapide / moins cher) :&lt;br&gt;– goulottes et rails : vis autoperceuses 4,2×13 tête large&lt;br&gt;&amp;nbsp;&amp;nbsp;(pas de pré-perçage ; épaisseur plaque à confirmer ≤ 2,5 mm)&lt;br&gt;&amp;nbsp;&amp;nbsp;variante : foret-taraud Ø4,2 / M5 + vis M5×10&lt;br&gt;– variateurs, DM860H, BW100, PE : Ø4,2 taraudé M5, rondelle éventail&lt;br&gt;&amp;nbsp;&amp;nbsp;(contact électrique plaque / CEM)&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles de pas&lt;/b&gt; : goulotte 50 mm des extrémités puis ≤ 400 mm ;&lt;br&gt;rail 25 mm des extrémités puis ≤ 200 mm (sur la fente la plus proche).&lt;br&gt;&lt;br&gt;&lt;b&gt;Repères&lt;/b&gt; provisoires, à aligner sur le schéma (IEC 81346-2).&lt;br&gt;Hors plaque : AU n°2, BP réarmement, voyants (porte) ; KTP700, AU n°1,&lt;br&gt;commutateur Auto/Manu (pupitre) ; ventilateurs (parois) ; éclairage (toit/porte)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;spacing=8;" vertex="1" parent="1"><mxGeometry x="1520.0" y="340.0" width="470.0" height="470.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Perçages"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c177" value="TTK – Tableau des perçages (68 points) – origine : coin haut gauche de la plaque, X → droite, Y → bas, mm" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40.0" y="30.0" width="900.0" height="40.0" as="geometry"/></mxCell><mxCell id="c178" value="&lt;table border='1' cellpadding='3' style='border-collapse:collapse;font-size:10px'&gt;&lt;tr style='background:#DDDDDD'&gt;&lt;th&gt;N°&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Objet&lt;/th&gt;&lt;th&gt;X plaque&lt;/th&gt;&lt;th&gt;Y plaque&lt;/th&gt;&lt;th&gt;Fixation&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;appareil&lt;/td&gt;&lt;td&gt;T1&lt;/td&gt;&lt;td&gt;650&lt;/td&gt;&lt;td&gt;200&lt;/td&gt;&lt;td&gt;Ø4,2 taraudé M5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;appareil&lt;/td&gt;&lt;td&gt;T1&lt;/td&gt;&lt;td&gt;690&lt;/td&gt;&lt;td&gt;200&lt;/td&gt;&lt;td&gt;Ø4,2 taraudé M5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;appareil&lt;/td&gt;&lt;td&gt;T1&lt;/td&gt;&lt;td&gt;650&lt;/td&gt;&lt;td&gt;400&lt;/td&gt;&lt;td&gt;Ø4,2 taraudé M5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;appareil&lt;/td&gt;&lt;td&gt;T1&lt;/td&gt;&lt;td&gt;690&lt;/td&gt;&lt;td&gt;400&lt;/td&gt;&lt;td&gt;Ø4,2 taraudé M5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;appareil&lt;/td&gt;&lt;td&gt;T2&lt;/td&gt;&lt;td&gt;750&lt;/td&gt;&lt;td&gt;200&lt;/td&gt;&lt;td&gt;Ø4,2 taraudé M5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;appareil&lt;/td&gt;&lt;td&gt;T2&lt;/td&