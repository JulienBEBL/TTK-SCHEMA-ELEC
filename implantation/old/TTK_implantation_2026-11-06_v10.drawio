whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#666666;strokeWidth=0.5;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="937.7" y="1382.5" width="5.2" height="55.0" as="geometry"/></mxCell><mxCell id="c311" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;strokeWidth=0.5;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="942.9" y="1382.5" width="2.2" height="55.0" as="geometry"/></mxCell><mxCell id="c312" value="&lt;b&gt;Porte H2 230 V&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=6;align=center;verticalAlign=top;fontColor=#000000;horizontal=0;" vertex="1" parent="1"><mxGeometry x="928.5" y="1440.0" width="20.6" height="46.0" as="geometry"/></mxCell><mxCell id="c313" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#595959;strokeColor=#262626;strokeWidth=1;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="945.1" y="1387.5" width="10.0" height="45.0" as="geometry"/></mxCell><mxCell id="c314" value="&lt;b&gt;Porte gauche&lt;/b&gt;&lt;br&gt;S1, S4, H2, H3, H4&lt;br&gt;faisceau → bornes&lt;br&gt;de porte sur R4&lt;br&gt;(à droite de XR2)" style="text;html=1;whiteSpace=wrap;fontSize=8;align=center;verticalAlign=top;fontColor=#806000;" vertex="1" parent="1"><mxGeometry x="50.0" y="860.0" width="130.0" height="120.0" as="geometry"/></mxCell><mxCell id="c315" value="EV1 entrée&lt;br&gt;paroi gauche bas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="50.0" y="1530.0" width="120.0" height="70.0" as="geometry"/></mxCell><mxCell id="c316" value="EV2 sortie&lt;br&gt;paroi droite haut" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1320.0" y="220.0" width="120.0" height="70.0" as="geometry"/></mxCell><mxCell id="c317" value="EL1 / EL2 : éclairage&lt;br&gt;(hors plaque)" style="text;html=1;whiteSpace=wrap;fontSize=8;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1320.0" y="320.0" width="140.0" height="40.0" as="geometry"/></mxCell><mxCell id="c318" value="&lt;b&gt;TTK – Armoire +A1 – Implantation plaque de montage – v10 (schéma v23, 06/11/2026)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200.0" y="65.0" width="1500.0" height="30.0" as="geometry"/></mxCell><mxCell id="c319" value="Plaque 1100 × 1670 × 3 – cotes en mm depuis le coin haut gauche – repères = nomenclature v23 – rails, variateurs, résistances, alimentations : déjà fixés (trait épais) ; positions Y des rails et X des vis = indice K, à relever" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200.0" y="98.0" width="1500.0" height="22.0" as="geometry"/></mxCell><mxCell id="c320" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;Trait épais : appareil déjà fixé &amp;nbsp;|&amp;nbsp; pointillé : cote à vérifier sur pièce&lt;br&gt;&lt;font color='#FF0000'&gt;Rouge pointillé&lt;/font&gt; : repère ou matériel à confirmer&lt;br&gt;&lt;font color='#0050A0'&gt;■&lt;/font&gt; vis de rail déjà posée (zone libre 20 mm) &amp;nbsp;|&amp;nbsp; &lt;font color='#7030A0'&gt;■&lt;/font&gt; support 45°&lt;br&gt;■ gris foncé 10 mm : renfort CLIPFIX 35&lt;br&gt;Borniers R5 : vert = borne de terre V/J ; gris = capot d'extrémité" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1470.0" y="400.0" width="520.0" height="130.0" as="geometry"/></mxCell><mxCell id="c321" value="&lt;b&gt;Nomenclature (v23)&lt;/b&gt;&lt;table border='1' cellpadding='2' style='border-collapse:collapse;font-size:9px'&gt;&lt;tr style='background:#DDDDDD'&gt;&lt;th&gt;Repère&lt;/th&gt;&lt;th&gt;Désignation&lt;/th&gt;&lt;th&gt;Référence&lt;/th&gt;&lt;th&gt;Emplacement&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;XPE1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Barrette de terre 27, vissée directement sur la plaque&lt;/td&gt;&lt;td&gt;Legrand 404839&lt;/td&gt;&lt;td&gt;plaque, haut gauche – FIXÉE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Alimentation 24 V (24VSEC)&lt;/td&gt;&lt;td&gt;RS PRO 284-0491&lt;/td&gt;&lt;td&gt;rang 1 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Alimentation 24 V (24VELEC)&lt;/td&gt;&lt;td&gt;RS PRO 284-0491&lt;/td&gt;&lt;td&gt;rang 1 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Alimentation 48 V&lt;/td&gt;&lt;td&gt;Mean Well NDR-240-48&lt;/td&gt;&lt;td&gt;rang 1 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Variateur M1&lt;/td&gt;&lt;td&gt;SEW MCX91A-0055-5E3&lt;/td&gt;&lt;td&gt;rang 1 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Variateur M2&lt;/td&gt;&lt;td&gt;SEW MCX91A-0055-5E3&lt;/td&gt;&lt;td&gt;rang 1 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;R1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Résistance de freinage U1&lt;/td&gt;&lt;td&gt;SEW BW100-001&lt;/td&gt;&lt;td&gt;rang 1 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;R2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Résistance de freinage U2&lt;/td&gt;&lt;td&gt;SEW BW100-001&lt;/td&gt;&lt;td&gt;rang 1 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Driver pas-à-pas M3&lt;/td&gt;&lt;td&gt;Jkongmotor JKDM860H&lt;/td&gt;&lt;td&gt;vissé sur la plaque (pas sur rail), rang 4 – position à relever&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Driver pas-à-pas M4&lt;/td&gt;&lt;td&gt;Jkongmotor JKDM860H&lt;/td&gt;&lt;td&gt;vissé sur la plaque (pas sur rail), rang 4 – position à relever&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Disjoncteur de tête&lt;/td&gt;&lt;td&gt;Hager NFT820&lt;/td&gt;&lt;td&gt;R2 – X 765→818 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QS1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Sectionneur général (largeur ≈ 140, à mesurer)&lt;/td&gt;&lt;td&gt;Legrand 022515&lt;/td&gt;&lt;td&gt;R2 – X 828→968 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;XR1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Répartiteur 1 (-XR1, décision 05/11) – alimenté par QF1 ; moteurs, freins, neutres T1-T3&lt;/td&gt;&lt;td&gt;AEE300427&lt;/td&gt;&lt;td&gt;R2 – X 646→718 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QM1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Disj. moteur U1&lt;/td&gt;&lt;td&gt;GV2ME14&lt;/td&gt;&lt;td&gt;R2 – X 408→452 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;KM1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Contacteur amont U1&lt;/td&gt;&lt;td&gt;LC1D09BD&lt;/td&gt;&lt;td&gt;R2 – X 452→498 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QM2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Disj. moteur U2&lt;/td&gt;&lt;td&gt;GV2ME14&lt;/td&gt;&lt;td&gt;R2 – X 498→542 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;KM2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Contacteur amont U2&lt;/td&gt;&lt;td&gt;LC1D09BD&lt;/td&gt;&lt;td&gt;R2 – X 542→588 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Disj. frein M1&lt;/td&gt;&lt;td&gt;A9F74202&lt;/td&gt;&lt;td&gt;R2 – X 182→218 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;KF1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Contacteur frein M1&lt;/td&gt;&lt;td&gt;LC1D09BD&lt;/td&gt;&lt;td&gt;R2 – X 218→264 – FIXÉ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Disj. frein M2&lt;/td&gt;&lt;td&gt;A9F74202&lt;/td&gt;&lt;td&gt;R2 – X 274→310 – FIXÉ&lt;/td&gt;&lt;/tr&gt;