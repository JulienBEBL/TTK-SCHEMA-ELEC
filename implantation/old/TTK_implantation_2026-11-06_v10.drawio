nt"/><mxPoint x="523.2" y="2098.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c1170" value="" style="endArrow=none;html=1;strokeColor=#D6B656;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="988.7" y="2086.0" as="sourcePoint"/><mxPoint x="988.7" y="2098.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c1171" value="" style="endArrow=none;html=1;strokeColor=#D6B656;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="523.2" y="2092.0" as="sourcePoint"/><mxPoint x="988.7" y="2092.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c1172" value="" style="endArrow=none;html=1;strokeColor=#D6B656;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="756.0" y="2082.0" as="sourcePoint"/><mxPoint x="756.0" y="2092.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c1173" value="&lt;b&gt;Faisceau porte&lt;/b&gt;&lt;br&gt;230 V · voyant H2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#B85450;strokeWidth=1;fontSize=10;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1077.5" y="2038.0" width="265.0" height="44.0" as="geometry"/></mxCell><mxCell id="c1174" value="" style="endArrow=none;html=1;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1181.0" y="2086.0" as="sourcePoint"/><mxPoint x="1181.0" y="2098.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c1175" value="" style="endArrow=none;html=1;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1239.0" y="2086.0" as="sourcePoint"/><mxPoint x="1239.0" y="2098.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c1176" value="" style="endArrow=none;html=1;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1181.0" y="2092.0" as="sourcePoint"/><mxPoint x="1239.0" y="2092.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c1177" value="" style="endArrow=none;html=1;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210.0" y="2082.0" as="sourcePoint"/><mxPoint x="1210.0" y="2092.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c1178" value="&lt;b&gt;Comptage&lt;/b&gt; : PT 2,5 74 ; PE 4 ; PT 4 10 → 88 bornes + X12.11 sur R3 = 89 (85 achetées + 4 de terre : manque 4)&lt;br&gt;Butées des borniers : 24 (10 mm) ; capots de fin : 21&lt;br&gt;Vert/jaune : W4, W12 et W13 → barrette -XPE1 (pas de borne). STO, RJ45 IHM : pas de borne.&lt;br&gt;Chiffres sous W11 / W12 : n° de conducteur du câble (ordre des bornes = f70)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1620.0" y="2448.0" width="900.0" height="200.0" as="geometry"/></mxCell><mxCell id="c1179" value="&lt;b&gt;Lecture&lt;/b&gt; : gris = borne PT 2,5 ; gris foncé = PT 4 ; vert/jaune = borne de terre ; noir = butée d'arrêt ; gris moyen = capot de fin.&lt;br&gt;Bandeau de couleur au-dessus = câble (repère, composition, destination). Étiquette sous les bornes = fonction.&lt;br&gt;Petit carré orange = bouton de déverrouillage push-in ; rectangle blanc = entrée de fil (haut : côté armoire, bas : côté câble)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60.0" y="2448.0" width="1500.0" height="200.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>