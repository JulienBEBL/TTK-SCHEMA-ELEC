" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#666666;strokeWidth=0.5;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1129.1" y="1627.5" width="6.2" height="55.0" as="geometry"/></mxCell><mxCell id="c263" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;strokeWidth=0.5;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1135.3" y="1627.5" width="2.2" height="55.0" as="geometry"/></mxCell><mxCell id="c264" value="&lt;b&gt;W1 réseau&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=6;align=center;verticalAlign=top;fontColor=#000000;horizontal=0;" vertex="1" parent="1"><mxGeometry x="1101.3" y="1685.0" width="40.2" height="40.0" as="geometry"/></mxCell><mxCell id="c265" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#595959;strokeColor=#262626;strokeWidth=1;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1137.5" y="1632.5" width="10.0" height="45.0" as="geometry"/></mxCell><mxCell id="c266" value="&lt;b&gt;Porte gauche&lt;/b&gt;&lt;br&gt;S1, S4, H2, H3, H4&lt;br&gt;faisceau → bornes&lt;br&gt;« Porte » (R5)" style="text;html=1;whiteSpace=wrap;fontSize=8;align=center;verticalAlign=top;fontColor=#806000;" vertex="1" parent="1"><mxGeometry x="50.0" y="860.0" width="130.0" height="120.0" as="geometry"/></mxCell><mxCell id="c267" value="EV1 entrée&lt;br&gt;paroi gauche bas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="50.0" y="1530.0" width="120.0" height="70.0" as="geometry"/></mxCell><mxCell id="c268" value="EV2 sortie&lt;br&gt;paroi droite haut" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1;fontSize=8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1320.0" y="220.0" width="120.0" height="70.0" as="geometry"/></mxCell><mxCell id="c269" value="EL1 / EL2 : éclairage&lt;br&gt;(hors plaque)" style="text;html=1;whiteSpace=wrap;fontSize=8;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1320.0" y="320.0" width="140.0" height="40.0" as="geometry"/></mxCell><mxCell id="c270" value="&lt;b&gt;TTK – Armoire +A1 – Implantation plaque de montage – v7 (schéma v16, 05/11/2026)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200.0" y="65.0" width="1500.0" height="30.0" as="geometry"/></mxCell><mxCell id="c271" value="Plaque 1100 × 1670 × 3 – cotes en mm depuis le coin haut gauche – repères = nomenclature v16 – rails, variateurs, résistances, alimentations : déjà fixés (trait épais) ; positions Y des rails et X des vis = indice K, à relever" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200.0" y="98.0" width="1500.0" height="22.0" as="geometry"/></mxCell><mxCell id="c272" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;Trait épais : appareil déjà fixé &amp;nbsp;|&amp;nbsp; pointillé : cote à vérifier sur pièce&lt;br&gt;&lt;font color='#FF0000'&gt;Rouge pointillé&lt;/font&gt; : repère ou matériel à confirmer&lt;br&gt;&lt;font color='#0050A0'&gt;■&lt;/font&gt; vis de rail déjà posée (zone libre 20 mm) &amp;nbsp;|&amp;nbsp; &lt;font color='#7030A0'&gt;■&lt;/font&gt; support 45°&lt;br&gt;■ gris foncé 10 mm : renfort CLIPFIX 35&lt;br&gt;Borniers R5 : vert = borne de terre V/J ; gris = capot d'extrémité" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1470.0" y="400.0" width="520.0" height="130.0" as="geometry"/></mxCell><mxCell id="c273" value="&lt;b&gt;Nomenclature (v16)&lt;/b&gt;&lt