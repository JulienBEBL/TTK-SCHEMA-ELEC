tml=1;fontSize=10;align=left;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="1250.0" y="1243.0" width="230.0" height="14.0" as="geometry"/></mxCell><mxCell id="c241" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#C00000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="1250.0" as="sourcePoint"/><mxPoint x="1248.0" y="1250.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c242" value="GH4 : Y 1350 → 1410 (axe 1380)" style="text;html=1;fontSize=10;align=left;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="1250.0" y="1483.0" width="230.0" height="14.0" as="geometry"/></mxCell><mxCell id="c243" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#C00000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="1490.0" as="sourcePoint"/><mxPoint x="1248.0" y="1490.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c244" value="GH5 : Y 1580 → 1640 (axe 1610)" style="text;html=1;fontSize=10;align=left;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="1250.0" y="1713.0" width="230.0" height="14.0" as="geometry"/></mxCell><mxCell id="c245" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#C00000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="1720.0" as="sourcePoint"/><mxPoint x="1248.0" y="1720.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c246" value="R1 : axe Y 320 ; X 150 → 425" style="text;html=1;fontSize=10;align=left;fontColor=#0050A0;" vertex="1" parent="1"><mxGeometry x="1250.0" y="453.0" width="280.0" height="14.0" as="geometry"/></mxCell><mxCell id="c247" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#0050A0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="460.0" as="sourcePoint"/><mxPoint x="1248.0" y="460.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c248" value="R2 : axe Y 730 ; X 100 → 1000" style="text;html=1;fontSize=10;align=left;fontColor=#0050A0;" vertex="1" parent="1"><mxGeometry x="1250.0" y="863.0" width="280.0" height="14.0" as="geometry"/></mxCell><mxCell id="c249" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#0050A0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="870.0" as="sourcePoint"/><mxPoint x="1248.0" y="870.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c250" value="R3 : axe Y 1000 ; X 100 → 1000" style="text;html=1;fontSize=10;align=left;fontColor=#0050A0;" vertex="1" parent="1"><mxGeometry x="1250.0" y="1133.0" width="280.0" height="14.0" as="geometry"/></mxCell><mxCell id="c251" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#0050A0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="1140.0" as="sourcePoint"/><mxPoint x="1248.0" y="1140.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c252" value="R4 : axe Y 1250 ; X 100 → 800" style="text;html=1;fontSize=10;align=left;fontColor=#0050A0;" vertex="1" parent="1"><mxGeometry x="1250.0" y="1383.0" width="280.0" height="14.0" as="geometry"/></mxCell><mxCell id="c253" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#0050A0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="1390.0" as="sourcePoint"/><mxPoint x="1248.0" y="1390.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c254" value="R5 : axe Y 1495 ; X 100 → 1000" style="text;html=1;fontSize=10;align=left;fontColor=#0050A0;" vertex="1" parent="1"><mxGeometry x="1250.0" y="1628.0" width="280.0" height="14.0" as="geometry"/></mxCell><mxCell id="c255" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#0050A0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="1635.0" as="sourcePoint"/><mxPoint x="1248.0" y="1635.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c256" value="réservation variateurs 310" style="html=1;endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=4;startSize=4;fontSize=11;strokeColor=#0050A0;fontColor=#0050A0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475.0" y="630.0" as="sourcePoint"/><mxPoint x="785.0" y="630.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c257" value="zone BW 345" style="html=1;endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=4;startSize=4;fontSize=11;strokeColor=#0050A0;fontColor=#0050A0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785.0" y="200.0" as="sourcePoint"/><mxPoint x="1130.0" y="200.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c258" value="90" style="html=1;endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=4;startSize=4;fontSize=11;strokeColor=#0050A0;fontColor=#0050A0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="1840.0" as="sourcePoint"/><mxPoint x="210.0" y="1840.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c259" value="90" style="html=1;endArrow=block;startArrow=block;endFill=1;startFill=1;endSize=4;startSize=4;fontSize=11;strokeColor=#0050A0;fontColor=#0050A0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130.0" y="1840.0" as="sourcePoint"/><mxPoint x="1220.0" y="1840.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c260" value="Ventilateur ENTRÉE&lt;br&gt;VF92AC paroi gauche, bas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=9;" vertex="1" parent="1"><mxGeometry x="5.0" y="1560.0" width="100.0" height="70.0" as="geometry"/></mxCell><mxCell id="c261" value="Ventilateur SORTIE&lt;br&gt;VF92AC paroi droite, haut" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1225.0" y="200.0" width="100.0" height="70.0" as="geometry"/></mxCell><mxCell id="c262" value="▼ ENTRÉE DES CÂBLES PAR LE BAS : commande/terrain côté GAUCHE – puissance/moteurs côté DROIT ▼" style="text;html=1;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120.0" y="1870.0" width="1100.0" height="30.0" as="geometry"/></mxCell><mxCell id="c263" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;&lt;font color='#C00000'&gt;●&lt;/font&gt; fixation goulotte (axe) &amp;nbsp; &lt;font color='#0050A0'&gt;●&lt;/font&gt; fixation rail DIN (axe)&lt;br&gt;&lt;font color='#7030A0'&gt;●&lt;/font&gt; fixation support 45° (position à confirmer après relevé)&lt;br&gt;■ gris foncé 10 mm : renfort de rail&lt;br&gt;Plein : cote vérifiée ou relevée &amp;nbsp;|&amp;nbsp; pointillé fin : cote supposée&lt;br&gt;Pointillé épais : réservation &amp;nbsp;|&amp;nbsp; &lt;font color='#FF0000'&gt;rouge pointillé&lt;/font&gt; : à commander / à définir&lt;br&gt;&lt;font color='#E06666'&gt;Cadre rose pointillé&lt;/font&gt; : dégagement à laisser libre&lt;br&gt;&lt;br&gt;&lt;b&gt;Fixation (plaque galvanisée 3 mm)&lt;/b&gt;&lt;br&gt;– goulottes, rails, supports 45° : trou de passage Ø5,5, vis M5 + rondelle,&lt;br&gt;&amp;nbsp;&amp;nbsp;écrou + rondelle au dos (vérifier le jeu derrière la plaque).&lt;br&gt;– rails : coupés 3,5 mm avant un oblong ; vis au centre d'un oblong (pas 25).&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Aucune vis sous un appareil&lt;/b&gt; : sur rail, vis dans une zone de vissage&lt;br&gt;&amp;nbsp;&amp;nbsp;libre (cadre bleu pointillé 20 mm) encadrée de 2 renforts ;&lt;br&gt;&amp;nbsp;&amp;nbsp;supports 45° uniquement là où aucune borne ne les recouvre.&lt;br&gt;– BW100 : posées 145 à l'horizontale (orientation non confirmée) ;&lt;br&gt;&amp;nbsp;&amp;nbsp;si 145 vertical imposé : zone BW 470 de large, variateurs 2 × 100.&lt;br&gt;– variateurs, DM860H, BW100 : Ø5,5 passage, M5 + rondelle éventail,&lt;br&gt;&amp;nbsp;&amp;nbsp;pointés sur pièce à réception (entraxes non connus).&lt;br&gt;Pas : goulotte 50 mm des bouts puis ≤ 400 ; rail : vis à chaque bout puis ≤ 250&lt;br&gt;(barrette PE : 350, rail rigidifié par la barrette).&lt;br&gt;&lt;br&gt;&lt;b&gt;Repères provisoires&lt;/b&gt;, à aligner sur le schéma (IEC 81346-2).&lt;br&gt;Hors plaque : AU n°2, BP réarmement, voyants (porte) ; KTP700, AU n°1,&lt;br&gt;commutateur Auto/Manu (pupitre) ; ventilateurs (parois) ; éclairage.&lt;br&gt;&lt;br&gt;&lt;b&gt;Porte&lt;/b&gt; : câblage direct en fil souple, faisceau sous gaine spiralée,&lt;br&gt;boucle à la charnière gauche → GV-G. Pas de bornier porte.&lt;br&gt;&lt;b&gt;Masses&lt;/b&gt; : portes et plaque reliées au PE par V/J 4 mm², cosse à œil&lt;br&gt;sur goujon M5/M6, rondelle éventail, contact métal nu." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;spacing=8;" vertex="1" parent="1"><mxGeometry x="1550.0" y="340.0" width="480.0" height="450.0" as="geometry"/></mxCell><mxCell id="c264" value="&lt;b&gt;Nomenclature – repère / fonction / référence&lt;/b&gt;&lt;br&gt;&lt;table border='1' cellpadding='2' style='border-collapse:collapse;font-size:10px'&gt;&lt;tr style='background:#BBBBBB'&gt;&lt;th&gt;Repère&lt;/th&gt;&lt;th&gt;Fonction&lt;/th&gt;&lt;th&gt;Référence&lt;/th&gt;&lt;/tr&gt;&lt;tr style='background:#DDDDDD'&gt;&lt;td colspan='3'&gt;&lt;b&gt;Rang 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;G1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Alimentation 24 V permanente (automate, sécurité, KTP)&lt;/td&gt;&lt;td&gt;RS PRO 284-0491&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;G2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Alimentation 24 V commutée&lt;/td&gt;&lt;td&gt;RS PRO 284-0491&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;G3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Alimentation 48 V drivers pas-à-pas&lt;/td&gt;&lt;td&gt;MEAN WELL NDR-240-48 (RS 122-2229)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;T1 / T2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Variateur motoréducteur M1 / M2&lt;/td&gt;&lt;td&gt;SEW MCX91A-0055-5E3-4-T00/001/CSO/CFN/CDM/CMM&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;R1 / R2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Résistance de freinage T1 / T2&lt;/td&gt;&lt;td&gt;SEW BW100-001&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#DDDDDD'&gt;&lt;td colspan='3'&gt;&lt;b&gt;Rang 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QS1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Interrupteur-sectionneur général cadenassable&lt;/td&gt;&lt;td&gt;Legrand 022515 Vistop 63 A 4P&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Disjoncteur général&lt;/td&gt;&lt;td&gt;Hager NFT820 3P+N 20 A C&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FA1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Parafoudre type 2 – OPTION, emplacement réservé&lt;/td&gt;&lt;td&gt;Schneider A9L16297&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;XD1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Répartiteur puissance 4P&lt;/td&gt;&lt;td&gt;AEE300427&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QM1 / QM2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Protection départ variateur T1 / T2&lt;/td&gt;&lt;td&gt;Schneider GV2ME14 (6–10 A)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;K1 / K2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Contacteur amont variateur T1 / T2 (relais sécu)&lt;/td&gt;&lt;td&gt;Schneider LC1D09BD + LADN11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF3 / QF4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Protection frein BE5 M1 / M2&lt;/td&gt;&lt;td&gt;Schneider A9F75202 2P 2 A D&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;KF1 / KF2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Contacteur frein BE5 M1 / M2 (relais sécu)&lt;/td&gt;&lt;td&gt;Schneider LC1D09BD + LADN11&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#DDDDDD'&gt;&lt;td colspan='3'&gt;&lt;b&gt;Rang 3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF10 / QF11&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Protection sortie 24 V G1 / G2&lt;/td&gt;&lt;td&gt;Schneider A9F74203 2P 3 A C&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Protection alimentation KTP700&lt;/td&gt;&lt;td&gt;Schneider A9F74201 2P 1 A C&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;K48&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Coupure 48 V pas-à-pas sur AU&lt;/td&gt;&lt;td&gt;Schneider LC1D09BD&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;K24&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Contacteur sortie G2 (24 V commuté) – À COMMANDER&lt;/td&gt;&lt;td&gt;Schneider LC1D09BD&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;KSA&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Relais de sécurité AU / capot&lt;/td&gt;&lt;td&gt;Schneider XPSUAF13AP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;A1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Automate CPU 1214C G2&lt;/td&gt;&lt;td&gt;Siemens 6ES7214-1AH50-0XB0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;A2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Module E/S TOR 8DI/8DQ&lt;/td&gt;&lt;td&gt;Siemens 6ES7223-5BH50-0XB0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;A3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Module 8 entrées thermocouple&lt;/td&gt;&lt;td&gt;Siemens 6ES7231-5QF50-0XB0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;A4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Switch PROFINET&lt;/td&gt;&lt;td&gt;Weidmüller 2682250000&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;XP1 / XP2 / XP3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Distribution +24 V perm. / +24 V commuté / 0 V&lt;/td&gt;&lt;td&gt;Phoenix PTFIX 6X1,5 + PTFIX 1,5-NS35&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#DDDDDD'&gt;&lt;td colspan='3'&gt;&lt;b&gt;Rang 4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;XD2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Répartiteur auxiliaires 230 V – OPTION&lt;/td&gt;&lt;td&gt;AEE300427&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF5 / QF6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Protection primaire G1 / G2&lt;/td&gt;&lt;td&gt;Hager NFT706 1P+N 6 A C&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Protection primaire G3&lt;/td&gt;&lt;td&gt;Schneider A9F75204 2P 4 A D&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF13&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Protection ventilateurs – À DÉFINIR&lt;/td&gt;&lt;td&gt;1P+N, 1 module&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF14&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Protection éclairage – À DÉFINIR&lt;/td&gt;&lt;td&gt;1P+N, 1 module&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;QF9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Protection prise de service 30 mA&lt;/td&gt;&lt;td&gt;IMO B6CR1N1630A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;XS1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Prise de service 230 V&lt;/td&gt;&lt;td&gt;Legrand 004280&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;X7 / X8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bornier ventilateurs / éclairage&lt;/td&gt;&lt;td&gt;Phoenix PT 2,5 (3209510)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;XP4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Distribution +48 V / 0 V 48&lt;/td&gt;&lt;td&gt;Phoenix PTFIX 6X1,5 + PTFIX 1,5-NS35&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;U1 / U2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Driver pas-à-pas axe 1 / 2&lt;/td&gt;&lt;td&gt;Leadshine DM860H (stock BEBL)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;X5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bornier freins BE5 M1 / M2&lt;/td&gt;&lt;td&gt;Phoenix PT 4 (3211757)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;X6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bornier moteurs pas-à-pas&lt;/td&gt;&lt;td&gt;Phoenix PT 4 (3211757)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#DDDDDD'&gt;&lt;td colspan='3'&gt;&lt;b&gt;Rang 5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;X1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bornier câble pupitre 27G1&lt;/td&gt;&lt;td&gt;Phoenix PT 2,5 (3209510)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;X2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bornier câble machine 19G1&lt;/td&gt;&lt;td&gt;Phoenix PT 2,5 (3209510)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;X3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bornier capteur capot magnétique M12&lt;/td&gt;&lt;td&gt;Phoenix PT 2,5 (3209510)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;X4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bornier sondes TF M1 / M2&lt;/td&gt;&lt;td&gt;Phoenix PT 2,5 (3209510)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;PE&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Barrette de terre 25 points (2e barrette en stock, non posée)&lt;/td&gt;&lt;td&gt;Legrand 404839 (RS 266-1257)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#DDDDDD'&gt;&lt;td colspan='3'&gt;&lt;b&gt;Accessoires&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;■ 10 mm&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Renfort / séparateur de fonction sur rail&lt;/td&gt;&lt;td&gt;Phoenix CLIPFIX 35 (3022218)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Supports R5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Support de rail incliné 45°&lt;/td&gt;&lt;td&gt;RS PRO 262-4193&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1550.0" y="810.0" width="560.0" height="900.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Plan de perçage"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c265" value="" style="html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40.0" y="40.0" width="2520.0" height="2080.0" as="geometry"/></mxCell><mxCell id="c266" value="&lt;b&gt;TTK – MISE EN PLAN DE PERÇAGE – PLAQUE DE MONTAGE&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="60.0" y="55.0" width="1500.0" height="30.0" as="geometry"/></mxCell><mxCell id="c267" value="" style="html=1;fillColor=none;strokeColor=#C8C8C8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="290.0" y="390.0" width="60.0" height="1610.0" as="geometry"/></mxCell><mxCell id="c268" value="" style="html=1;fillColor=none;strokeColor=#C8C8C8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeomet