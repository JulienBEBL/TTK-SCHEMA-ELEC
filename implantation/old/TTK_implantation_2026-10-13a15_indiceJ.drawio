olor=#808080;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="lay_TER"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint x="805.0" y="1820.0" as="sourcePoint"/><mxPoint x="982.2" y="1662.5" as="targetPoint"/><Array as="points"><mxPoint x="805.0" y="1767.5"/><mxPoint x="982.2" y="1767.5"/></Array></mxGeometry></mxCell><mxCell id="c922" value="T09" style="endArrow=oval;startArrow=oval;endSize=4;startSize=4;html=1;rounded=0;strokeColor=#808080;strokeWidth=2;fontSize=9;fontStyle=1;fontColor=#808080;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="lay_TER"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint x="901.0" y="1820.0" as="sourcePoint"/><mxPoint x="1031.6" y="1662.5" as="targetPoint"/><Array as="points"><mxPoint x="901.0" y="1767.5"/><mxPoint x="1031.6" y="1767.5"/></Array></mxGeometry></mxCell><mxCell id="c923" value="T10" style="endArrow=oval;startArrow=oval;endSize=4;startSize=4;html=1;rounded=0;strokeColor=#808080;strokeWidth=2;fontSize=9;fontStyle=1;fontColor=#808080;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="lay_TER"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint x="395.0" y="1820.0" as="sourcePoint"/><mxPoint x="725.0" y="1202.5" as="targetPoint"/><Array as="points"><mxPoint x="395.0" y="1767.5"/><mxPoint x="197.5" y="1767.5"/><mxPoint x="197.5" y="1280.5"/><mxPoint x="725.0" y="1280.5"/></Array></mxGeometry></mxCell><mxCell id="c924" value="T11" style="endArrow=oval;startArrow=oval;endSize=4;startSize=4;html=1;rounded=0;strokeColor=#808080;strokeWidth=2;fontSize=9;fontStyle=1;fontColor=#808080;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="lay_TER"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint x="957.5" y="395.0" as="sourcePoint"/><mxPoint x="605.0" y="610.0" as="targetPoint"/><Array as="points"><mxPoint x="957.5" y="757.5"/><mxPoint x="605.0" y="757.5"/></Array></mxGeometry></mxCell><mxCell id="c925" value="&lt;b&gt;Calques (fonctions)&lt;/b&gt;&lt;br&gt;&lt;font color='#000000'&gt;━━&lt;/font&gt; 1 – Puissance AC 400/230 V&lt;br&gt;&lt;font color='#2D7600'&gt;━━&lt;/font&gt; 2 – Terre PE et masses&lt;br&gt;&lt;font color='#E00000'&gt;━━&lt;/font&gt; 3 – Distribution 24 V&lt;br&gt;&lt;font color='#7030A0'&gt;━━&lt;/font&gt; 4 – Sécurité (AU, capot, STO, bobines)&lt;br&gt;&lt;font color='#0050A0'&gt;━━&lt;/font&gt; 5 – Signaux automate&lt;br&gt;&lt;font color='#E07000'&gt;━━&lt;/font&gt; 6 – 48 V et moteurs pas-à-pas&lt;br&gt;&lt;font color='#00A0A0'&gt;━━&lt;/font&gt; 7 – PROFINET&lt;br&gt;&lt;font color='#808080'&gt;━━&lt;/font&gt; 8 – Câbles terrain dans l'armoire&lt;br&gt;&lt;br&gt;Trait pointillé : option, à vérifier, ou câble terrain.&lt;br&gt;Commande/signaux par GV-G ; puissance, 48 V, PE par GV-D.&lt;br&gt;Dans une goulotte, chaque fonction suit son propre couloir (décalage de 5 mm).&lt;br&gt;&lt;br&gt;&lt;b&gt;Code couleur des fils (proposition, IEC 60204-1 §13.2.4 + stock)&lt;/b&gt;&lt;br&gt;Phases AC : noir (4 amont protections, 2,5 aval GV2, 1 aval 1-6 A)&lt;br&gt;Neutre : bleu&lt;br&gt;PE et masses : vert/jaune 2,5 – 4 mm²&lt;br&gt;+24 V : rouge 1,5 &amp;nbsp;|&amp;nbsp; 0 V : bleu 1,5 / 1&lt;br&gt;Sécurité (AU, capot, STO, bobines, boucle de retour) : violet 1&lt;br&gt;Signaux automate : blanc 1 &amp;nbsp;|&amp;nbsp; Sondes TF : gris 1&lt;br&gt;+48 V : orange 1,5 &amp;nbsp;|&amp;nbsp; Phases pas-à-pas : gris 2,5&lt;br&gt;&lt;br&gt;&lt;b&gt;Limite&lt;/b&gt; : plan déduit de l'architecture (pas de schéma).&lt;br&gt;Nombres de fils « ≈ » à recaler sur le schéma WinRelais." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;spacing=8;" vertex="1" parent="lay_fond"><mxGeometry x="1280.0" y="180.0" width="480.0" height="560.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="Liste des liaisons"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c926" value="TTK – Liste des liaisons internes (85 liaisons) – indice J – PORTE = porte gauche ; E.. = entrées plaque passe-câbles" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="20.0" width="1400.0" height="50.0" as="geometry"/></mxCell><mxCell id="c927" value="&lt;table border='1' cellpadding='3' style='border-collapse:collapse;font-size:10px'&gt;&lt;tr style='background:#BBBBBB'&gt;&lt;th&gt;N°&lt;/th&gt;&lt;th&gt;De&lt;/th&gt;&lt;th&gt;Vers&lt;/th&gt;&lt;th&gt;Conducteurs&lt;/th&gt;&lt;th&gt;Couleur&lt;/th&gt;&lt;th&gt;Parcours&lt;/th&gt;&lt;th&gt;Remarque&lt;/th&gt;&lt;th&gt;Statut&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='8' style='background:#000000;color:#FFFFFF'&gt;&lt;b&gt;1 – Puissance AC 400/230 V&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W01&lt;/b&gt;&lt;/td&gt;&lt;td&gt;QS1&lt;/td&gt;&lt;td&gt;QF1&lt;/td&gt;&lt;td&gt;3 × 4 mm² + N 4 mm²&lt;/td&gt;&lt;td&gt;noir / bleu&lt;/td&gt;&lt;td&gt;GH2&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;font color='#C00000'&gt;bleu 4 manquant&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W02&lt;/b&gt;&lt;/td&gt;&lt;td&gt;QF1&lt;/td&gt;&lt;td&gt;XD1&lt;/td&gt;&lt;td&gt;3 × 4 mm² + N 4 mm²&lt;/td&gt;&lt;td&gt;noir / bleu&lt;/td&gt;&lt;td&gt;GH2&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;font color='#C00000'&gt;bleu 4 manquant&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W03&lt;/b&gt;&lt;/td&gt;&lt;td&gt;XD1&lt;/td&gt;&lt;td&gt;QM1&lt;/td&gt;&lt;td&gt;3 × 4 mm²&lt;/td&gt;&lt;td&gt;noir&lt;/td&gt;&lt;td&gt;GH2&lt;/td&gt;&lt;td&gt;amont protection : section du NFT820&lt;/td&gt;&lt;td&gt;&lt;font color='#000000'&gt;ok&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W04&lt;/b&gt;&lt;/td&gt;&lt;td&gt;XD1&lt;/td&gt;&lt;td&gt;QM2&lt;/td&gt;&lt;td&gt;3 × 4 mm²&lt;/td&gt;&lt;td&gt;noir&lt;/td&gt;&lt;td&gt;GH2&lt;/td&gt;&lt;td&gt;idem&lt;/td&gt;&lt;td&gt;&lt;font color='#000000'&gt;ok&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W05&lt;/b&gt;&lt;/td&gt;&lt;td&gt;QM1&lt;/td&gt;&lt;td&gt;K1&lt;/td&gt;&lt;td&gt;3 × 2,5 mm²&lt;/td&gt;&lt;td&gt;noir&lt;/td&gt;&lt;td&gt;GH2&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;font color='#000000'&gt;ok&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W06&lt;/b&gt;&lt;/td&gt;&lt;td&gt;QM2&lt;/td&gt;&lt;td&gt;K2&lt;/td&gt;&lt;td&gt;3 × 2,5 mm²&lt;/td&gt;&lt;td&gt;noir&lt;/td&gt;&lt;td&gt;GH2&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;font color='#000000'&gt;ok&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W07&lt;/b&gt;&lt;/td&gt;&lt;td&gt;K1&lt;/td&gt;&lt;td&gt;T1&lt;/td&gt;&lt;td&gt;3 × 2,5 mm²&lt;/td&gt;&lt;td&gt;noir&lt;/td&gt;&lt;td&gt;GH1&lt;/td&gt;&lt;td&gt;réseau L1/L2/L3 variateur&lt;/td&gt;&lt;td&gt;&lt;font color='#000000'&gt;ok&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W08&lt;/b&gt;&lt;/td&gt;&lt;td&gt;K2&lt;/td&gt;&lt;td&gt;T2&lt;/td&gt;&lt;td&gt;3 × 2,5 mm²&lt;/td&gt;&lt;td&gt;noir&lt;/td&gt;&lt;td&gt;GH1&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;font color='#000000'&gt;ok&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W09&lt;/b&gt;&lt;/td&gt;&lt;td&gt;XD1&lt;/td&gt;&lt;td&gt;QF3&lt;/td&gt;&lt;td&gt;2 × 4 mm²&lt;/td&gt;&lt;td&gt;noir&lt;/td&gt;&lt;td&gt;GH2&lt;/td&gt;&lt;td&gt;amont protection&lt;/td&gt;&lt;td&gt;&lt;font color='#000000'&gt;ok&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;XD1&lt;/td&gt;&lt;td&gt;QF4&lt;/td&gt;&lt;td&gt;2 × 4 mm²&lt;/td&gt;&lt;td&gt;noir&lt;/td&gt;&lt;td&gt;GH2&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;font color='#000000'&gt;ok&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;W11&lt;/b&gt;&lt;/td&gt;&lt;td&gt;QF3&lt;/td&gt;&lt;td&gt;KF1&lt;/td&gt;&lt;td&gt;2 × 1 mm²&lt;/td&gt;&lt;td&gt;noir&lt;/td&gt;&lt;td&gt;GH2